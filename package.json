{
  "name": "ladder-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "A calm, levelled language course engine (ladder-core) and its courses.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w english-ladder",
    "build": "npm run build -w english-ladder",
    "preview": "npm run preview -w english-ladder",
    "content:check": "npm run content:check -w english-ladder",
    "test": "npm run test -w english-ladder",
    "test:watch": "npm run test:watch -w english-ladder",
    "test:e2e": "npm run test:e2e -w english-ladder",
    "lint": "npm run lint -w english-ladder",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.18.12",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.33",
    "eslint-config-prettier": "9.1.2",
    "gray-matter": "4.0.3",
    "js-yaml": "4.1.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "zod": "3.25.76"
  }
}

{
  "name": "spanish-ladder",
  "version": "0.1.0",
  "private": true,
  "description": "A calm, levelled Spanish course for Indonesian speakers, from zero to C1.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run content:check",
    "build": "next build",
    "preview": "node ../../packages/ladder-core/scripts/serve.mjs",
    "data:import": "tsx scripts/data-import.ts",
    "content:check": "tsx ../../packages/ladder-core/scripts/content-check.ts",
    "audio:list": "tsx scripts/audio-list.ts",
    "audio:ingest": "tsx ../../packages/ladder-core/scripts/audio-ingest.ts",
    "icons": "node ../../packages/ladder-core/scripts/make-icons.mjs '#7D3B24'",
    "sw": "node ../../packages/ladder-core/scripts/make-sw.mjs spanish-ladder- v0.1.0 '' rung/dasar/ rung/easy-1/ rung/easy-2/ placement/ review/ words/ me/ settings/ about/ manifest.webmanifest icons/icon.svg audio/manifest.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "next lint",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@ladder/core": "*",
    "next": "14.2.33",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "harfbuzzjs": "0.4.15",
    "wawoff2": "2.0.1"
  }
}

{
  "name": "japanese-ladder",
  "version": "0.1.0",
  "private": true,
  "description": "A calm, levelled Japanese course for Indonesian speakers, from zero to N1.",
  "scripts": {
    "predev": "npm run fonts:subset",
    "dev": "next dev",
    "prebuild": "npm run data:check && npm run content:check && npm run fonts:subset",
    "build": "next build",
    "preview": "node ../../packages/ladder-core/scripts/serve.mjs",
    "data:fetch": "tsx scripts/data-fetch.ts",
    "data:import": "tsx scripts/data-import.ts",
    "data:check": "tsx scripts/data-check.ts",
    "content:check": "tsx ../../packages/ladder-core/scripts/content-check.ts",
    "strokes:extract": "tsx scripts/strokes-extract.ts",
    "fonts:fetch": "tsx ../../packages/ladder-core/scripts/fonts-fetch.ts",
    "fonts:subset": "tsx ../../packages/ladder-core/scripts/fonts-subset.ts",
    "icons": "node ../../packages/ladder-core/scripts/make-icons.mjs '#2A2830'",
    "sw": "node ../../packages/ladder-core/scripts/make-sw.mjs --cache-first strokes:.json japanese-ladder- v0.1.0 '' rung/kana-1/ rung/kana-2/ rung/easy-1/ placement/ review/ words/ me/ settings/ about/ manifest.webmanifest icons/icon.svg audio/manifest.json",
    "pretest": "node -e \"process.exit(require('fs').existsSync('fonts-src/KleeOne-Regular.ttf') ? 0 : 1)\" && npm run fonts:subset || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "next lint",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@ladder/core": "*",
    "next": "14.2.33",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "subset-font": "2.4.0"
  }
}
